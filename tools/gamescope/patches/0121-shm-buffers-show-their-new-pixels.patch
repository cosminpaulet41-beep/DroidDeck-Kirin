diff --git a/src/steamcompmgr.cpp b/src/steamcompmgr.cpp
index 214677d..e2c3a8a 100644
--- a/src/steamcompmgr.cpp
+++ b/src/steamcompmgr.cpp
@@ -1851,16 +1851,29 @@ import_commit (
 		commit->fifo = false;
 	}
 
+	struct wlr_dmabuf_attributes dmabuf = {0};
+	const bool bDmabuf = wlr_buffer_get_dmabuf( buf, &dmabuf );
+
 	if ( gamescope::OwningRc<CVulkanTexture> pTexture = s_BufferMemos.LookupVulkanTexture( buf ) )
 	{
-		// Going from OwningRc -> Rc now.
-		commit->vulkanTex = pTexture;
-		return commit;
+		// A dma-buf texture is the client's memory itself. An shm one is a copy of the buffer's
+		// first contents, and the client has drawn into the buffer again since: copy the new
+		// pixels in, or start a new texture while the old one is still being shown.
+		if ( bDmabuf || ( !pTexture->IsInUse() && vulkan_update_texture_from_wlr_buffer( pTexture.get(), buf ) ) )
+		{
+			// Going from OwningRc -> Rc now.
+			commit->vulkanTex = pTexture;
+			return commit;
+		}
+
+		wlserver_lock();
+		if ( s_BufferMemos.LookupVulkanTexture( buf ) != nullptr )
+			s_BufferMemos.UnmemoizeBuffer( buf );
+		wlserver_unlock();
 	}
 
-	struct wlr_dmabuf_attributes dmabuf = {0};
